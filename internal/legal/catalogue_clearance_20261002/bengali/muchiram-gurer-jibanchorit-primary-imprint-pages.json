    {
      "pageid": 803809,
      "ns": 104,
      "title": "পাতা:মুচিরাম গুড়ের জীবনচরিত - বঙ্কিমচন্দ্র চট্টোপাধ্যায়.pdf/১০",
      "revisions": [
        {
          "revid": 1962377,
          "parentid": 1956249,
          "timestamp": "2026-06-11T14:38:16Z",
          "slots": {
            "main": {
              "contentmodel": "proofread-page",
              "contentformat": "text/x-wiki",
              "content": "<noinclude><pagequality level=\"3\" user=\"কমলেশ মণ্ডল\" /></noinclude>{{dhr|10em}}\n{{কেন্দ্র|{{larger|'''বিজ্ঞাপন'''}}}}\n\n{{ফাঁক}}পাঠকদিগকে বলিয়া দেওয়া আবশ্যক যে, এই গ্রন্থ কোন ব্যক্তিবিশেষ বা শ্রেণীবিশেষের লোককে লক্ষ্য করিয়া লিখিত হয় নাই। সাধারণ সমাজ ভিন্ন, কাহারও প্রতি ইহাতে ব্যঙ্গ নাই। ইহাতে পাঠক যেরূপ মনুষ্যচরিত্র দেখিবেন, সেরূপ মনুষ্যচরিত্র সকল সমাজে, সকল কালেই বিদ্যমান। আধুনিক বাঙ্গালী সমাজ, এই গ্রন্থের বিশেষ লক্ষ্য বটে; কিন্তু তৎস্থিত কোন ব্যক্তিবিশেষ বা শ্রেণীবিশেষ তাহার লক্ষ্য নহে। যদি কেহ বিবেচনা করেন যে, তিনিই ইহার লক্ষ্য, তবে ভরসা করি, তিনি কথাটা মনে মনেই রাখিবেন। প্রকাশে তাঁহার গৌরব বৃদ্ধির সম্ভাবনা দেখি না।\n{{dhr|10em}}<noinclude></noinclude>"
            }
          }
        }
      ]
