      "original_content_sha256": "3ad29d39908abc6655d06f7e3bc0fedec9a4702f7ae3de30fba496a29410f95f",
      "proposed_content_sha256": "b590f4ed7dd763216a55fd650bf5719794445ffbba3ccd347ccc615e5231e86b",
      "removed_exact_tail": "\n\n↑ পাঠক মহাশয় বৃহল্লাঙ্গুলের ন্যায়শাস্ত্রে ব্যুৎপত্তি দেখিয়া বিস্মিত হইবেন না। এইরূপ তর্কে মাক্ষমূলর স্থির করিয়াছেন যে, প্রাচীন ভারতবর্ষীয়েরা লিখিতে জানিতেন না। এইরূপ তর্কে জেমস মিল স্থির করিয়াছেন যে, প্রাচীন ভারতবর্ষীষেরা অসভ্য জাতি, এবং সংস্কৃত ভাষা অসভ্য ভাষা। বস্তুতঃ এই ব্যাঘ্র পণ্ডিতে এবং মহ্য পণ্ডিতে অধিক বৈলক্ষণ্য দেখা যায় না।",
      "removed_note_count": 1,
      "narrative_prefix_byte_exact": true,
      "changed": true
    },
