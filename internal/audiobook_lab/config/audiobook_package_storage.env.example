# Local controlled-operator profile for immutable audiobook package storage.
# Never copy upload or retention-admin credentials into Railway. Do not commit
# a populated copy. Production deletion credentials are intentionally absent.
#
# Create distinct bucket-scoped application keys in each B2 account. Use exact
# capabilities rather than the broader web-console presets:
#
# upload:
#   listAllBucketNames,listBuckets,listFiles,readFiles,readFileRetentions,writeFiles
#   Restrict to the exact bucket and name prefix v1/prod/sprint1/.
#
# retention preflight (read-only despite the legacy RETENTION_ADMIN name):
#   listBuckets,readBuckets,readBucketRetentions
#   Restrict to the exact bucket. Do not grant a name prefix because this key
#   reads only bucket configuration and never reads or writes object bytes.
#
# Neither profile needs deleteFiles, bypassGovernance, writeFileRetentions,
# writeBucketRetentions, writeBuckets, or deleteBuckets.

B2_AUDIOBOOK_PROD_S3_ENDPOINT=https://s3.<primary-region>.backblazeb2.com
B2_AUDIOBOOK_PROD_REGION=<primary-region>
B2_AUDIOBOOK_PROD_BUCKET=<private-production-audiobook-bucket>
B2_AUDIOBOOK_PROD_ACCOUNT_ID=<primary-account-id>
B2_AUDIOBOOK_PROD_UPLOAD_ACCESS_KEY_ID=<primary-upload-key-id>
B2_AUDIOBOOK_PROD_UPLOAD_SECRET_ACCESS_KEY=<primary-upload-secret>
B2_AUDIOBOOK_PROD_RETENTION_ADMIN_ACCESS_KEY_ID=<primary-retention-admin-key-id>
B2_AUDIOBOOK_PROD_RETENTION_ADMIN_SECRET_ACCESS_KEY=<primary-retention-admin-secret>

B2_AUDIOBOOK_DR_S3_ENDPOINT=https://s3.<dr-region>.backblazeb2.com
B2_AUDIOBOOK_DR_REGION=<dr-region>
B2_AUDIOBOOK_DR_BUCKET=<private-dr-audiobook-bucket>
B2_AUDIOBOOK_DR_ACCOUNT_ID=<independent-dr-account-id>
B2_AUDIOBOOK_DR_UPLOAD_ACCESS_KEY_ID=<dr-upload-key-id>
B2_AUDIOBOOK_DR_UPLOAD_SECRET_ACCESS_KEY=<dr-upload-secret>
B2_AUDIOBOOK_DR_RETENTION_ADMIN_ACCESS_KEY_ID=<dr-retention-admin-key-id>
B2_AUDIOBOOK_DR_RETENTION_ADMIN_SECRET_ACCESS_KEY=<dr-retention-admin-secret>
