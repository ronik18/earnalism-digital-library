{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theearnalism.com/schemas/audiobook_package_manifest.v2.schema.json",
  "title": "Earnalism immutable audiobook package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "package_version",
    "release_evidence_version",
    "release_descriptor_sha256",
    "source_sha256",
    "manuscript_sha256",
    "duration_ms",
    "segment_count",
    "word_count",
    "paragraph_count",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": "audiobook_package_manifest.v2"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^sha256-[a-f0-9]{64}$"
    },
    "release_evidence_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "release_descriptor_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manuscript_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "segment_count": {
      "type": "integer",
      "minimum": 1
    },
    "word_count": {
      "type": "integer",
      "minimum": 1
    },
    "paragraph_count": {
      "type": "integer",
      "minimum": 1
    },
    "sync_tier": {
      "type": "string",
      "maxLength": 80
    },
    "highlight_sync_enabled": {
      "type": "boolean"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter_id",
        "order",
        "start_word",
        "end_word",
        "start_paragraph",
        "end_paragraph",
        "chunks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "chapter_id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "start_word": {
          "type": "integer",
          "minimum": 0
        },
        "end_word": {
          "type": "integer",
          "minimum": 0
        },
        "start_paragraph": {
          "type": "integer",
          "minimum": 0
        },
        "end_paragraph": {
          "type": "integer",
          "minimum": 0
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "order",
        "start_word",
        "end_word",
        "start_paragraph",
        "end_paragraph",
        "cumulative_start_ms",
        "duration_ms",
        "assets"
      ],
      "properties": {
        "segment_id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "start_word": {
          "type": "integer",
          "minimum": 0
        },
        "end_word": {
          "type": "integer",
          "minimum": 0
        },
        "start_paragraph": {
          "type": "integer",
          "minimum": 0
        },
        "end_paragraph": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720000
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audio",
            "timestamps",
            "vtt",
            "metadata"
          ],
          "properties": {
            "audio": {
              "$ref": "#/$defs/asset"
            },
            "timestamps": {
              "$ref": "#/$defs/asset"
            },
            "vtt": {
              "$ref": "#/$defs/asset"
            },
            "metadata": {
              "$ref": "#/$defs/asset"
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "mime_type",
        "storage",
        "replicas"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "replicas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storage"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "bucket",
        "key",
        "version_id"
      ],
      "properties": {
        "store": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "bucket": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
