{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theearnalism.com/schemas/audiobook_package_manifest.v2.schema.json",
  "title": "Earnalism immutable audiobook package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "package_version",
    "release_evidence_version",
    "source_sha256",
    "duration_ms",
    "segment_count",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": "audiobook_package_manifest.v2"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(sha256-)?[a-f0-9]{64}$"
    },
    "release_evidence_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "segment_count": {
      "type": "integer",
      "minimum": 1
    },
    "sync_tier": {
      "type": "string",
      "maxLength": 80
    },
    "highlight_sync_enabled": {
      "type": "boolean"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter_id",
        "order",
        "chunks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "chapter_id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "order",
        "start_word",
        "end_word",
        "cumulative_start_ms",
        "duration_ms",
        "audio_size_bytes",
        "audio_sha256",
        "timestamps_sha256",
        "audio_url",
        "timestamps_url"
      ],
      "properties": {
        "segment_id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "start_word": {
          "type": "integer",
          "minimum": 0
        },
        "end_word": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720000
        },
        "audio_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "audio_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "timestamps_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audio_url": {
          "type": "string",
          "format": "uri"
        },
        "timestamps_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
